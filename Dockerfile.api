# ==========================================
# Dockerfile for Backend Core API Layer
# ==========================================

FROM node:22-alpine AS builder

WORKDIR /app

# Copy package descriptors
COPY package*.json ./
RUN npm ci

# Copy sources
COPY tsconfig.json vite.config.ts ./
COPY src/types.ts ./src/types.ts
COPY server/ ./server/
COPY server.ts ./

# Compile server bundle with esbuild to target/CJS
RUN npx esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs

# Production phase
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

# Copy compiled server modules
COPY --from=builder /app/dist/server.cjs ./dist/server.cjs

EXPOSE 8080

ENV NODE_ENV=production
ENV PORT=8080

CMD ["node", "dist/server.cjs"]
